# Copy to .env and fill in. NEVER commit the real .env.

# RPC used by the resolution checks, passed via the X-Rpc-Url header so those
# endpoints are FREE (BYO compute) instead of hitting the paid 402 path.
# Use a FREE public node so the probes cost nothing on JustaName's dRPC account.
# PublicNode works; llamarpc/ankr returned 400. Checks run every 5min so we
# don't lean too hard on a free endpoint.
RPC_URL=https://ethereum-rpc.publicnode.com

# Names that should ALWAYS resolve in prod. KNOWN_NAME drives the single-resolve
# check; KNOWN_NAME_2 is the second entry in the batch-resolve check.
KNOWN_NAME=justaname.eth
KNOWN_NAME_2=nick.eth

# An address whose reverse record is stable, for the /ens/v2/reverse probe.
KNOWN_ADDRESS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# Optional: the exact ETH address KNOWN_NAME should resolve to, to enable the
# strongest correctness assertion (see the commented condition in config.yaml).
EXPECTED_ADDRESS=0x0000000000000000000000000000000000000000

# Any valid JustaName api key (32 alphanumeric chars). The bundler checks pass
# it as the ?api-key= query param (not a header) — no special "bundler" key is
# needed, any valid key works. Prefer a key dedicated to monitoring so you can
# rotate/revoke it independently. If the key has a domain allowlist, either add
# the monitor's domain or use a key with no allowlist.
BUNDLER_API_KEY=replace-with-a-valid-justaname-api-key

# Slack incoming webhook for alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
