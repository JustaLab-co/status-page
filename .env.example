# Copy to .env and fill in. NEVER commit the real .env.

# dRPC https URL with your API key (the reliable RPC for CCIP-Read).
# Passed as X-Rpc-Url so /v2/resolve is free instead of hitting the 402 paywall.
RPC_URL=https://lb.drpc.live/ethereum/<YOUR_KEY>

# A name that should ALWAYS resolve in prod (a stable JustaName subname or a
# well-known .eth). The probe asserts result.data.ens equals this.
KNOWN_NAME=justaname.eth

# An address whose reverse record is stable, for the /v2/reverse probe.
KNOWN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: the exact ETH address KNOWN_NAME should resolve to, to enable the
# strongest correctness assertion (see the commented condition in config.yaml).
EXPECTED_ADDRESS=0x0000000000000000000000000000000000000000

# Slack incoming webhook for alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
