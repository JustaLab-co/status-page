# Auto-HTTPS reverse proxy for the status page.
# Caddy fetches + renews a Let's Encrypt cert for each domain automatically.
# Requirements: health.jaw.id and health.justaname.id A-records -> droplet IP,
# ports 80 & 443 open.
# Only the public page is routed. Gatus and its API stay off the internet.
health.jaw.id, health.justaname.id {
	reverse_proxy web:3000
}
